{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug (ASan + UBSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "BSR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release (-O3 + LTO)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BSR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "bench (release con simbolos, -march=native permitido)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O3 -g -march=native",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "BSR_BUILD_TESTS": "OFF",
        "BSR_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "bench-deployisa",
      "inherits": "base",
      "displayName": "bench con la ISA de deploy (linea base publicable)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O3 -g -march=x86-64-v2 -mtune=generic",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "BSR_BUILD_TESTS": "OFF",
        "BSR_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": "base",
      "displayName": "profile (perf)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O2 -g -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "BSR_BUILD_TESTS": "OFF",
        "BSR_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "deploy",
      "inherits": "base",
      "displayName": "deploy (ISA portable, sin native)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3 -march=x86-64-v2 -mtune=generic",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -static-libstdc++ -static-libgcc",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BSR_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "bench-deployisa", "configurePreset": "bench-deployisa" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "deploy", "configurePreset": "deploy" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ]
}
